# Google Antigravity CLI (`agy`), tracking Google's own release manifests.
#
# Reuses the nixpkgs-unstable packaging (install as bin/agy, autoPatchelf on
# Linux, versionCheckHook) and swaps in the version/src from
# pkgs/antigravity-cli/version.json, which is generated by
# `./scripts/antigravity-cli.sh update`.
{ inputs }:
final: prev:
let
  versionData = builtins.fromJSON (builtins.readFile ../pkgs/antigravity-cli/version.json);
  system = final.stdenv.hostPlatform.system;
in
{
  antigravity-cli = final.unstable.antigravity-cli.overrideAttrs (old: {
    inherit (versionData) version;
    src =
      if versionData.platforms ? ${system} then
        final.fetchurl { inherit (versionData.platforms.${system}) url hash; }
      else
        throw "antigravity-cli: unsupported system '${system}'";
    passthru = (old.passthru or { }) // {
      wholeVersion = "${versionData.version}-${versionData.buildId}";
      updateScript = null;
    };
    meta = old.meta // {
      platforms = builtins.attrNames versionData.platforms;
    };
  });
}
