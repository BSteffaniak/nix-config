                    "git ls-remote": "allow",
                    "git ls-remote *": "allow",
                    "git remote": "allow",
                    "git remote -v": "allow",
                    "git remote show *": "allow",
                    "git remote get-url *": "allow",
                    "git help *": "allow",
                    "git rev-parse *": "allow",
                    "git describe *": "allow",
                    "git tag": "allow",
                    "git tag -l": "allow",
                    "git tag -l *": "allow",
                    "git tag --list": "allow",
                    "git tag --list *": "allow",
                    "git shortlog *": "allow",
                    "git blame *": "allow",
                    "git stash list": "allow",
