                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* stash show ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* branch --list ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* branch --show-current ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get-all ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get-regexp ...": "allow"
                }
