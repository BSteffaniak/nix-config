{
    "agent": {
        "build": {
            "permission": {
                "bash": {
                    "git push --force *": "deny",
                    "git push --force-with-lease *": "deny",
                    "git push -f *": "deny",
                    "git reset --hard *": "deny",
                    "git clean -f *": "deny",
                    "git clean -fd *": "deny",
                    "git clean -fx *": "deny",
                    "git clean -fdx *": "deny",
                    "git filter-branch *": "deny",
                    "git reflog expire *": "deny",
                    "git reflog delete *": "deny",
                    "git gc --prune=now *": "deny",
                    "git update-ref -d *": "deny"
                },
                "command_patterns": {
                    "git <options>* push --force ...": "deny",
                    "git <options>* push --force-with-lease ...": "deny",
                    "git <options>* push -f ...": "deny",
                    "git <options>* reset --hard ...": "deny",
                    "git <options>* clean -f ...": "deny",
                    "git <options>* clean -fd ...": "deny",
                    "git <options>* clean -fx ...": "deny",
                    "git <options>* clean -fdx ...": "deny",
                    "git <options>* filter-branch ...": "deny",
                    "git <options>* reflog expire ...": "deny",
                    "git <options>* reflog delete ...": "deny",
                    "git <options>* gc --prune=now ...": "deny",
                    "git <options>* update-ref -d ...": "deny",
                    "git <options>* push [<arg>]* --force ...": "deny",
                    "git <options>* push [<arg>]* --force-with-lease ...": "deny",
                    "git <options>* push [<arg>]* -f ...": "deny"
                }
            }
        },
        "plan": {
            "permission": {
                "bash": {
                    "git *": "deny",
                    "git status": "allow",
                    "git status *": "allow",
                    "git log": "allow",
                    "git log *": "allow",
                    "git show": "allow",
                    "git show *": "allow",
                    "git diff": "allow",
                    "git diff *": "allow",
                    "git diff-tree *": "allow",
                    "git branch": "allow",
                    "git ls-files": "allow",
                    "git ls-files *": "allow",
                    "git ls-remote": "allow",
                    "git ls-remote *": "allow",
                    "git remote": "allow",
                    "git remote -v": "allow",
                    "git remote show *": "allow",
                    "git remote get-url *": "allow",
                    "git help *": "allow",
                    "git rev-parse *": "allow",
                    "git describe *": "allow",
                    "git tag": "allow",
                    "git tag -l": "allow",
                    "git tag -l *": "allow",
                    "git tag --list": "allow",
                    "git tag --list *": "allow",
                    "git shortlog *": "allow",
                    "git blame *": "allow",
                    "git stash list": "allow",
                    "git stash list *": "allow",
                    "git stash show": "allow",
                    "git stash show *": "allow",
                    "git rev-list *": "allow",
                    "git cat-file *": "allow",
                    "git name-rev *": "allow",
                    "git for-each-ref *": "allow",
                    "git count-objects *": "allow",
                    "git worktree list": "allow",
                    "git worktree list *": "allow",
                    "git branch --list": "allow",
                    "git branch --list *": "allow",
                    "git branch -l": "allow",
                    "git branch -l *": "allow",
                    "git branch --show-current": "allow",
                    "git config --get *": "allow",
                    "git config --get-all *": "allow",
                    "git config --get-regexp *": "allow",
                    "git config --list": "allow",
                    "git config --list *": "allow",
                    "git config -l": "allow",
                    "git config -l *": "allow"
                },
                "command_patterns": {
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* diff ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* log ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* show ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* status ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* stash list ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* stash show ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* branch --list ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* branch --show-current ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get-all ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get-regexp ...": "allow"
                }
            }
        }
    }
}
