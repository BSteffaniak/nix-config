{
    "agent": {
        "build": {
            "permission": {
                "bash": {
                    "git checkout *": "deny",
                    "git switch *": "deny",
                    "git add *": "deny",
                    "git mv *": "deny",
                    "git rm *": "deny",
                    "git reset *": "deny",
                    "git restore *": "deny",
                    "git remove *": "deny",
                    "git commit *": "deny",
                    "git push *": "deny",
                    "git pull *": "deny",
                    "git merge *": "deny",
                    "git rebase *": "deny",
                    "git revert *": "deny",
                    "git cherry-pick *": "deny",
                    "git am *": "deny",
                    "git apply *": "deny",
                    "git clean *": "deny",
                    "git tag *": "deny",
                    "git ls-remote": "allow",
                    "git ls-remote *": "allow",
                    "git tag": "allow",
                    "git tag -l": "allow",
                    "git tag -l *": "allow",
                    "git tag --list": "allow",
                    "git tag --list *": "allow",
                    "git stash": "deny",
                    "git stash --include-untracked": "deny",
                    "git stash -u": "deny",
                    "git stash drop": "deny",
                    "git stash pop": "deny",
                    "git stash apply": "deny",
                    "git stash clear": "deny",
                    "git stash create": "deny",
                    "git stash store": "deny",
                    "git worktree add *": "deny",
                    "git worktree remove *": "deny",
                    "git submodule update *": "deny",
                    "git stash list": "allow",
                    "git stash list *": "allow",
                    "git stash show": "allow",
                    "git stash show *": "allow",
                    "git --no-pager stash list": "allow",
                    "git --no-pager stash list *": "allow",
                    "git --no-pager stash show": "allow",
                    "git --no-pager stash show *": "allow"
                },
                "command_patterns": {
                    "git <options>* checkout ...": "deny",
                    "git <options>* switch ...": "deny",
                    "git <options>* add ...": "deny",
                    "git <options>* mv ...": "deny",
                    "git <options>* rm ...": "deny",
                    "git <options>* reset ...": "deny",
                    "git <options>* restore ...": "deny",
                    "git <options>* remove ...": "deny",
                    "git <options>* commit ...": "deny",
                    "git <options>* push ...": "deny",
                    "git <options>* pull ...": "deny",
                    "git <options>* merge ...": "deny",
                    "git <options>* rebase ...": "deny",
                    "git <options>* revert ...": "deny",
                    "git <options>* cherry-pick ...": "deny",
                    "git <options>* am ...": "deny",
                    "git <options>* apply ...": "deny",
                    "git <options>* clean ...": "deny",
                    "git [--no-pager] worktree add ...": "deny",
                    "git [--no-pager] worktree remove ...": "deny",
                    "git <options>* submodule update ...": "deny",
                    "git <options>* stash": "deny",
                    "git <options>* stash push ...": "deny",
                    "git <options>* stash save ...": "deny",
                    "git <options>* stash drop ...": "deny",
                    "git <options>* stash pop ...": "deny",
                    "git <options>* stash apply ...": "deny",
                    "git <options>* stash clear ...": "deny",
                    "git <options>* stash create ...": "deny",
                    "git <options>* stash store ...": "deny",
                    "git <options>* stash branch ...": "deny",
                    "git <options>* stash export ...": "deny",
                    "git <options>* stash import ...": "deny",
                    "git <options>* stash --include-untracked ...": "deny",
                    "git <options>* stash -u ...": "deny",
                    "git <options>* stash /-.*/ ...": "deny"
                }
            }
        },
        "plan": {
            "permission": {
                "bash": {
                    "git *": "deny",
                    "git status": "allow",
                    "git status *": "allow",
                    "git log": "allow",
                    "git log *": "allow",
                    "git show": "allow",
                    "git show *": "allow",
                    "git diff": "allow",
                    "git diff *": "allow",
                    "git diff-tree *": "allow",
                    "git branch": "allow",
                    "git ls-tree": "allow",
                    "git ls-tree *": "allow",
                    "git ls-files": "allow",
                    "git ls-files *": "allow",
                    "git ls-remote": "allow",
                    "git ls-remote *": "allow",
                    "git remote": "allow",
                    "git remote -v": "allow",
                    "git remote show *": "allow",
                    "git remote get-url *": "allow",
                    "git help *": "allow",
                    "git rev-parse *": "allow",
                    "git describe *": "allow",
                    "git tag": "allow",
                    "git tag -l": "allow",
                    "git tag -l *": "allow",
                    "git tag --list": "allow",
                    "git tag --list *": "allow",
                    "git shortlog *": "allow",
                    "git blame *": "allow",
                    "git stash list": "allow",
                    "git stash list *": "allow",
                    "git stash show": "allow",
                    "git stash show *": "allow",
                    "git rev-list *": "allow",
                    "git cat-file *": "allow",
                    "git name-rev *": "allow",
                    "git for-each-ref *": "allow",
                    "git count-objects *": "allow",
                    "git worktree list": "allow",
                    "git worktree list *": "allow",
                    "git branch --list": "allow",
                    "git branch --list *": "allow",
                    "git branch -l": "allow",
                    "git branch -l *": "allow",
                    "git branch --show-current": "allow",
                    "git config --get *": "allow",
                    "git config --get-all *": "allow",
                    "git config --get-regexp *": "allow",
                    "git config --list": "allow",
                    "git config --list *": "allow",
                    "git config -l": "allow",
                    "git config -l *": "allow"
                },
                "command_patterns": {
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* diff ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* log ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* show ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* status ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* stash list ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* stash show ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* branch --list ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* branch --show-current ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get-all ...": "allow",
                    "git [-C <arg> | /-C.+/ | --no-pager | --literal-pathspecs | --no-optional-locks]* config --get-regexp ...": "allow"
                }
            }
        }
    }
}
