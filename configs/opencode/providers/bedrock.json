{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "bedrock-anthropic": {
            "npm": "@ai-sdk/anthropic",
            "name": "Claude on Bedrock",
            "options": {
                "baseURL": "https://bedrock-mantle.us-east-1.api.aws/anthropic",
                "apiKey": "{env:AWS_BEARER_TOKEN_BEDROCK}"
            },
            "models": {
                "anthropic.claude-opus-5": {
                    "name": "Opus 5",
                    "reasoning": true,
                    "attachment": true,
                    "limit": {
                        "context": 1000000,
                        "output": 128000
                    }
                }
            }
        }
    },
    "model": "bedrock-anthropic/anthropic.claude-opus-5",
    "small_model": "bedrock-anthropic/anthropic.claude-opus-5",
    "agent": {
        "build": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        },
        "plan": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        },
        "explore": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        },
        "general": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        },
        "title": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        },
        "summary": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        },
        "compaction": {
            "model": "bedrock-anthropic/anthropic.claude-opus-5"
        }
    }
}
