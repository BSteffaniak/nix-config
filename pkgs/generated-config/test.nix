# Build with: nix build --impure --expr 'let f = builtins.getFlake (toString ./.); pkgs = import f.inputs.nixpkgs { system = builtins.currentSystem; }; in import ./pkgs/generated-config/test.nix { inherit pkgs; }'
{ pkgs }:
let
  wrap = pkgs.callPackage ./default.nix { };
  source = pkgs.runCommand "generated-config-fixture" { } ''
    mkdir -p "$out"
    printf 'd /run/avahi-daemon - avahi avahi -\n' > "$out/00-nixos.conf"
    printf 'L+ /run/opengl-driver - - - - /nix/store/example\n' > "$out/graphics-driver.conf"
  '';
  wrapped = wrap {
    source = "${source}/*";
    target = "tmpfiles.d";
    repositoryPath = "/checkout";
  };
  direct = wrap {
    source = "${source}/00-nixos.conf";
    target = "tmpfiles.d/00-nixos.conf";
    repositoryPath = "/checkout";
  };
in
pkgs.runCommand "generated-config-wildcard-test" { } ''
  mkdir -p "$out/tmpfiles.d"
  # Expand the wrapped source just as NixOS's /etc builder does.
  for file in ${wrapped}; do
    ln -s "$file" "$out/tmpfiles.d/$(basename "$file")"
  done
  test "$(find "$out/tmpfiles.d" -type l | wc -l)" -eq 2
  grep -q '^# Generated by the Nix configuration at /checkout' "$out/tmpfiles.d/00-nixos.conf"
  grep -q '^d /run/avahi-daemon ' "$out/tmpfiles.d/00-nixos.conf"
  grep -q '^L+ /run/opengl-driver ' "$out/tmpfiles.d/graphics-driver.conf"
  grep -q '^d /run/avahi-daemon ' ${direct}
''
