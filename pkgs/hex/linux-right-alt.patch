+    #[test]
+    fn right_alt_hold_release_and_repeat() {
+        let mut state = right_alt_state();
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 1), Some(Start));
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 2), None);
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 0), Some(Finish));
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 0), None);
+    }
+
+    #[test]
+    fn right_alt_does_not_confuse_left_alt_or_other_modifiers() {
+        let mut state = right_alt_state();
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_LEFTALT, 1), None);
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 1), None);
+        right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 0);
+        right_alt_event(&mut state, KeyCode::KEY_LEFTALT, 0);
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 1), Some(Start));
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_LEFTALT, 1), Some(Cancel));
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 0), None);
+    }
+
