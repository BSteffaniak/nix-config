+        let mut state = right_alt_state();
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 1), Some(Start));
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_ESC, 1), Some(Cancel));
+        right_alt_event(&mut state, KeyCode::KEY_ESC, 0);
+        right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 0);
+        assert_eq!(right_alt_event(&mut state, KeyCode::KEY_RIGHTALT, 1), Some(Start));
+        assert_eq!(state.update(Input::Disconnected("keyboard".into()), Instant::now()), Some(Cancel));
+    }
