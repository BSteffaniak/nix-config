+    fn right_alt_state() -> HotkeyState {
+        let mut state = HotkeyState::new(&LinuxHotkey {
+            control: false, alt: false, shift: false, super_key: false,
+            key: "right_alt".into(),
+        }, false).unwrap();
+        state.update(Input::Connected("keyboard".into(), HashSet::new()), Instant::now());
