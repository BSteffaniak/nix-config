# Add provenance at the file boundary, including files generated by upstream modules.
{
  fileOption,
  defaultRepositoryPath,
  noticeTarget,
}:
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.myConfig.generatedFiles;
  wrapSource = pkgs.callPackage ../pkgs/generated-config { };
  files = lib.getAttrFromPath fileOption config;
in
{
  options = {
    myConfig.generatedFiles = {
      enable = lib.mkEnableOption "generated configuration notices" // {
        default = true;
      };
      repositoryPath = lib.mkOption {
        type = lib.types.str;
        default = defaultRepositoryPath config;
        description = "Location of the editable Nix checkout, printed in generated configuration notices.";
      };
    };
  }
  // lib.setAttrByPath fileOption (
    lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule (
          { config, ... }: {
            options = {
              generatedHeader = lib.mkOption {
                type = lib.types.bool;
                default = true;
                description = "Add a provenance header when the file format supports comments. Disable for format-sensitive files.";
              };
              source = lib.mkOption {
                apply =
                  source:
                  if cfg.enable && config.generatedHeader then
                    wrapSource {
                      inherit source;
                      inherit (config) target;
                      inherit (cfg) repositoryPath;
                    }
                  else
                    source;
              };
            };
          }
        )
      );
    }
  );

  config = lib.mkIf cfg.enable (
    lib.setAttrByPath (fileOption ++ [ noticeTarget ]) {
      generatedHeader = false;
      text = ''
        Generated by the Nix configuration at ${cfg.repositoryPath}.
        DO NOT EDIT managed configuration files, regardless of who is making the change.
        Edit the sources in ${cfg.repositoryPath}, then run ./rebuild.sh from that directory.

        Comment-capable files carry this notice in their headers. Strict JSON,
        binary files, unknown formats and out-of-store symlinks are left unchanged.
        Files below include directory trees; individual files can opt out of headers.

        Managed targets:
        ${lib.concatStringsSep "\n" (
          lib.mapAttrsToList (_: file: file.target) (lib.filterAttrs (_: file: file.enable) files)
        )}
      '';
    }
  );
}
